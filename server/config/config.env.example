# Example environment file for local development.
# Copy this to `.env` (or `config.env`) and fill in real values.
# Never commit a file that contains real secrets.

# HTTP port the API listens on
PORT=4000

# MongoDB connection string
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>

# JWT auth
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRE=7d
COOKIE_EXPIRE=5

# Stripe (optional)
STRIPE_API_KEY=your_stripe_api_key
STRIPE_SECRET_KEY=your_stripe_secret_key

# SMTP (optional email transport)
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SERVICE=gmail
SMTP_MAIL=you@example.com
SMTP_PASSWORD=your_smtp_password

# SendGrid (optional email transport)
SENDGRID_API_KEY=SG.your_sendgrid_api_key
SENDGRID_MAIL=you@example.com
SENDGRID_RESET_TEMPLATEID=your_reset_template_id
SENDGRID_ORDER_TEMPLATEID=your_order_template_id

# Cloudinary (image uploads)
CLOUDINARY_NAME=your_cloudinary_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Paytm (optional payments)
PAYTM_MID=your_paytm_mid
PAYTM_MERCHANT_KEY=your_paytm_merchant_key
PAYTM_WEBSITE=WEBSTAGING
PAYTM_CHANNEL_ID=WEB
PAYTM_INDUSTRY_TYPE=Retail
PAYTM_CUST_ID=your_paytm_customer_id

# Runtime environment
NODE_ENV=development
